# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# Supabase project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Service role key — server only, keep secret. NOT the anon/public key.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string — used to sign login tokens.
JWT_SECRET=

# Comma-separated allowed origins for CORS. Required when NODE_ENV=production
# (the server refuses to start in production without it). Example for a
# Vercel-hosted frontend:
#   FRONTEND_URL=https://your-app.vercel.app
# Leave empty in development to allow any origin.
FRONTEND_URL=
